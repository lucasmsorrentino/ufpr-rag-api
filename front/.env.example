# Copie para .env na VM e preencha. O .env NUNCA é versionado (ver .gitignore).

# Chave da API gratuita da NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=

# Endereço PRIVADO da VM do RAG, na rede da VCN (não acessível pela internet)
RAG_API_URL=http://10.0.0.78:8100

# Opcionais (os defaults estão em llm.py / main.py)
# Antes de trocar LLM_MODEL, meça a latência: no tier gratuito da NVIDIA ela
# varia de 0,7 s a 67 s conforme o modelo. Ver "Escolha do modelo" no README.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL_FALLBACK=meta/llama-3.1-8b-instruct
# LLM_TIMEOUT=45
# RATE_LIMIT_PER_MIN=15
